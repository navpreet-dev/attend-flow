generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A student identified by the roll no they use on the AGC ERP portal.
// Credentials are stored ONLY when the user opts into "remember me / auto-sync",
// encrypted at rest with AES-256-GCM.
model Student {
  id           String    @id @default(cuid())
  rollNo       String    @unique
  passwordEnc  String?
  rememberMe   Boolean   @default(false)
  name         String?
  course       String?
  section      String?
  department   String?
  incharge     String?
  threshold    Float     @default(75)
  autoSync     Boolean   @default(true)
  notifyLow    Boolean   @default(true)
  lastSyncAt   DateTime?
  lastSyncOk   Boolean?
  // Authenticated AGC ERP portal cookies (AES-256-GCM sealed), captured after a
  // successful sync so later syncs can skip the rate-limited login page entirely.
  // Stored only under the same remember-me consent as the password.
  portalCookiesEnc String?
  portalCookiesAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions   Session[]
  subjects   SubjectAttendance[]
  logs       AttendanceLog[]
  syncEvents SyncEvent[]
  pushSubs   PushSubscription[]

  // Optional Academic Planner & Timetable
  academicCalendar AcademicCalendar?
  timetableEntries TimetableEntry[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  studentId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model SubjectAttendance {
  id          String   @id @default(cuid())
  studentId   String
  subjectCode String
  subjectName String
  subjectType String   @default("Theory")
  saId        String?
  attended    Int      @default(0)
  total       Int      @default(0)
  percentage  Float    @default(0)
  lastUpdated DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectCode])
  @@index([studentId])
}

model AttendanceLog {
  id          String   @id @default(cuid())
  studentId   String
  subjectCode String
  date        String // dd-MM-yyyy as reported by the portal
  status      String // PRESENT | ABSENT
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectCode, date])
  @@index([studentId, date])
}

model SyncEvent {
  id        String   @id @default(cuid())
  studentId String
  status    String // SUCCESS | FAILED
  message   String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Web Push endpoints (one per device/browser) so low-attendance alerts
// reach the student even when the site is closed.
model PushSubscription {
  id        String   @id @default(cuid())
  studentId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Optional Academic Calendar configured by the student
model AcademicCalendar {
  id                String   @id @default(cuid())
  studentId         String   @unique
  startDate         String   // YYYY-MM-DD
  endDate           String   // YYYY-MM-DD
  workingDays       String   @default("1,2,3,4,5") // comma-separated: 1=Mon...7=Sun
  timetableOffDays  String   @default("")          // comma-separated day nums from timetable (e.g. "1" = Monday off)
  sourceFileName    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  holidays AcademicHoliday[]
}

model AcademicHoliday {
  id         String           @id @default(cuid())
  calendarId String
  date       String           // YYYY-MM-DD
  name       String?
  createdAt  DateTime         @default(now())
  calendar   AcademicCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([calendarId])
}

// Optional Weekly Timetable configured by the student
model TimetableEntry {
  id                 String   @id @default(cuid())
  studentId          String
  dayOfWeek          Int      // 1 = Monday ... 7 = Sunday
  subjectCode        String
  subjectName        String
  startTime          String   // HH:mm
  endTime            String   // HH:mm
  room               String?
  teacher            String?
  matchedSubjectCode String?  // Matched AttendFlow portal subjectCode
  sourceFileName     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

